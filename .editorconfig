# Purpose: Editor settings for every file in this repository, so that every editor saves the same
#          encoding, line endings and indentation.
# Role: EditorConfig settings (https://editorconfig.org), read by any editor that supports
#       EditorConfig; no build or CI step reads them. .gitattributes makes Git itself use the same
#       LF line endings.

# Stop here: ignore .editorconfig files in the folders above this one.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python's style guide, PEP 8, indents by four spaces.
[*.py]
indent_size = 4

# The repository's shell style keeps every line within 80 columns.
[*.sh]
max_line_length = 80

# One wrap width for the repository's configuration and workflow files. A pinned reference that
# cannot be split (an action's commit with its version comment, an image digest) may run longer.
[{*.yaml,*.yml,*.json5,*.jsonc,.gitignore,.gitattributes,.editorconfig,CODEOWNERS}]
max_line_length = 98
