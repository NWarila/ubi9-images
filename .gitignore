!/docs/decision-records/repo/0002-keep-the-renovate-configuration-self-contained.md
!/docs/decision-records/template/
!/docs/decision-records/template/.gitkeep

# Shared by every image: the scripts that lock, build and test it, the lists
# that build/generate-lock.sh reads, and the OpenSSL configuration.
!/build/
!/build/build-image.sh
!/build/download-rpms.sh
!/build/generate-lock.sh
!/build/held-rpms.aarch64.txt
!/build/held-rpms.x86_64.txt
!/build/install-tools.txt
!/build/openssl-fips.cnf
!/build/remove-install-only.sh
!/build/test-image.sh

# The images, one folder each: its Dockerfile, digests.txt (the digest each
